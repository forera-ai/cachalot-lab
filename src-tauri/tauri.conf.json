{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cachalot Lab",
  "version": "0.7.0",
  "identifier": "com.prooshani.cachalotstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cachalot Lab",
        "width": 1380,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
